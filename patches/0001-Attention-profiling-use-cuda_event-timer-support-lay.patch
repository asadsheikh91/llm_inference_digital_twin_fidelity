From 6a452955c195296882ef8f1436a44efcd2648b78 Mon Sep 17 00:00:00 2001
From: Asad Amad <asadamad81@gmail.com>
Date: Sat, 10 Oct 2026 19:12:24 +0500
Subject: [PATCH] Attention profiling: use cuda_event timer; support layer
 counts not divisible by 8

- attention_wrapper: profile_method kineto -> cuda_event (kineto/CUPTI records no
  GPU kernels under WSL2)
- get_max_num_blocks: use the largest pipeline degree <= 8 dividing num_layers
  instead of asserting divisibility (TinyLlama has 22 layers)

---
 vidur/profiling/attention/attention_wrapper.py | 2 +-
 vidur/profiling/utils/__init__.py              | 9 ++++++++-
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/vidur/profiling/attention/attention_wrapper.py b/vidur/profiling/attention/attention_wrapper.py
index b991420..d96bca7 100644
--- a/vidur/profiling/attention/attention_wrapper.py
+++ b/vidur/profiling/attention/attention_wrapper.py
@@ -37,7 +37,7 @@ class AttentionWrapper:
         attention_backend: AttentionBackend,
         dtype: torch.dtype,
     ):
-        self.time_stats_store = TimerStatsStore(profile_method="kineto")
+        self.time_stats_store = TimerStatsStore(profile_method="cuda_event")
 
         self._model_config = model_config
         self._parallel_config = parallel_config
diff --git a/vidur/profiling/utils/__init__.py b/vidur/profiling/utils/__init__.py
index aeb9b18..227fcdc 100644
--- a/vidur/profiling/utils/__init__.py
+++ b/vidur/profiling/utils/__init__.py
@@ -164,7 +164,14 @@ def get_max_num_blocks(
         * model_config.get_head_size()
         * element_size
     )
-    assert model_config.num_layers % max_pipeline_parallel_size == 0
+    # Use the largest pipeline degree <= max_pipeline_parallel_size that divides
+    # num_layers, so models like TinyLlama (22 layers) are supported. Unchanged
+    # for models whose layer count is divisible by max_pipeline_parallel_size.
+    max_pipeline_parallel_size = max(
+        p
+        for p in range(1, max_pipeline_parallel_size + 1)
+        if model_config.num_layers % p == 0
+    )
     block_memory_total = block_memory_size * (
         model_config.num_layers // max_pipeline_parallel_size
     )
-- 
2.34.1

